{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": { "source": "~/.config/fastfetch/ascii.txt", "type": "auto" }, "display": { "separator": " "},
	"modules": [
		{ "key": "╭────╮", "keyColor": "34", "type": "custom"                                        },
		{ "key": "│   │", "keyColor": "34", "type": "title",    "format": "{user-name}@{host-name}" },
		{ "key": "│   │", "keyColor": "34", "type": "os",       "format": "{name}"                  },
		{ "key": "│   │", "keyColor": "34", "type": "shell",    "format": "{1}"                     },
		{ "key": "│ 󰏓  │", "keyColor": "34", "type": "packages", "format": "{all}"                   },
		{ "key": "│   │", "keyColor": "34", "type": "terminal", "format": "{1}"                     },
		{ "key": "│   │", "keyColor": "34", "type": "wm",       "format": "{1}"                     },
		{ "key": "│ 󰝚  │", "keyColor": "34", "type": "media",    "format": "{artist} - {title}"      },
		{ "key": "╰────╯", "keyColor": "34", "type": "custom"                                        }
	]
}
